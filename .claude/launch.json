{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5717,
      "autoPort": true
    },
    {
      "name": "marketing",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--prefix",
        "marketing",
        "--",
        "--port",
        "4183"
      ],
      "port": 4183,
      "autoPort": true
    },
    {
      "name": "marketing-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "marketing",
        "--",
        "--port",
        "5174"
      ],
      "port": 5174,
      "autoPort": true
    },
    {
      "name": "worker-local",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "wrangler",
        "dev",
        "--port",
        "8787",
        "--ip",
        "127.0.0.1"
      ],
      "port": 8787
    },
    {
      "name": "web-worker",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_API_BASE_URL=http://localhost:8787",
        "npm",
        "run",
        "dev"
      ],
      "port": 5717
    }
  ]
}
