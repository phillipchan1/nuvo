# Supabase project — copy to .env and fill in
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# PostHog — project API key is publishable (like the Supabase anon key). Host
# is https://us.i.posthog.com or https://eu.i.posthog.com. Leave unset to
# disable capture. Privacy rules live in src/lib/posthog.ts (D-114).
# VITE_POSTHOG_PROJECT_TOKEN=phc_...
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# Optional — DEV ONLY password auto-login. Nuvo is Google-only in the UI; this
# only works if the user still has an email identity. Prefer staying signed in,
# or clear these and use Continue with Google. Put real values in .env.local.
# Tree-shaken out of every production build.
# VITE_DEV_EMAIL=you@example.com
# VITE_DEV_PASSWORD=your-password

# Resend — server-only (Supabase secret RESEND_API_KEY). Used by stripe-webhook
# to email when a friend uses your code / you earn a free month. Not a Vite env.
# RESEND_API_KEY=re_...
# RESEND_FROM=Nuvo <hello@nuvo.day>

# iOS App Store IAP — StoreKit Product ID strings (not prices, not Apple IDs).
# Connect group Nuvo Pro 22327993 (not submitted, no intro offer).
# Monthly Apple ID 6804259519 · Annual Apple ID 6804258767 — Connect-internal only.
# Product IDs passed to product() are these strings:
# VITE_NUVO_IAP_MONTHLY=NUVO_IAP_MONTHLY
# VITE_NUVO_IAP_ANNUAL=NUVO_IAP_ANNUAL
# Server (supabase secrets): same values. Trial is app-side trial_ends_at.
