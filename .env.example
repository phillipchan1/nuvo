# Supabase project — copy to .env and fill in
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional — DEV ONLY password auto-login. Nuvo is Google-only in the UI; this
# only works if the user still has an email identity. Prefer staying signed in,
# or clear these and use Continue with Google. Put real values in .env.local.
# Tree-shaken out of every production build.
# VITE_DEV_EMAIL=you@example.com
# VITE_DEV_PASSWORD=your-password
