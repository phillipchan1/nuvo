# Supabase project — copy to .env and fill in
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional — DEV ONLY. If set, `npm run dev` / `npm run tauri:dev` auto-signs-in
# this account so you skip the login wall while testing. Put real values in the
# gitignored .env.local, never here. Tree-shaken out of every production build.
# VITE_DEV_EMAIL=you@example.com
# VITE_DEV_PASSWORD=your-password
