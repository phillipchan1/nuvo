node_modules
dist
.env
.env.local
*.local
.DS_Store
supabase/.temp

# Marketing site installs its own deps (separate package.json)
marketing/node_modules
marketing/dist
marketing/dist-ssr

# Tauri
src-tauri/target
src-tauri/gen/schemas
# iOS Xcode project — regenerated by `tauri ios init` in CI and locally
src-tauri/gen/apple

# Updater signing keys must NEVER be committed (they live in ~/.tauri; this is a
# belt-and-suspenders guard against a stray copy in the repo).
*.key
src-tauri/*.key
src-tauri/*.key.pub

# Release pipeline build artifacts (generated in CI / dev, not source)
public/changelog.json
RELEASE_NOTES.md

# Eval artifacts: `npm run eval` writes cassettes that `npm test` then replays
# and asserts on. A run with any failing scenario would otherwise arm a CI break
# for whoever commits next. The run history (runs.jsonl) IS tracked on purpose.
tests/agent/cassettes/
.scratch/
