# Marketing site config — set these in the Vercel project's Environment Variables.
# Both have safe fallbacks in src/config.ts, so local dev works without a .env.local.

# Where every "Open app" CTA points (the product subdomain).
VITE_APP_URL=https://app.nuvo.day

# Inbox behind the "Request access" mailto links.
VITE_ACCESS_EMAIL=hello@nuvo.day
