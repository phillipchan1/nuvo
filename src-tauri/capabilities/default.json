{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Nuvo",
  "windows": ["main", "spotlight", "focus"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "updater:default",
    "opener:default",
    "process:default",
    "deep-link:default",
    "nuvo-watch:default",
    "nuvo-iap:default",
    "nuvo-siwa:default"
  ]
}
