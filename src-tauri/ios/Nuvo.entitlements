<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the iOS app.

  Source of truth for what the committed Xcode project at src-tauri/gen/apple
  signs with. scripts/ios-siwa.rb still merges these keys into
  project.yml's entitlements.properties if that spec is regenerated, so a
  local `tauri ios init` + postinit cannot silently drop them.

  NOT by repointing CODE_SIGN_ENTITLEMENTS: xcodegen's `entitlements` key owns
  that build setting and silently overwrites it, which would ship a build with
  Tauri's empty `<dict/>` and a 4.8 rejection. See that script's header.

  In-app purchase needs NO entitlement key: the capability is implicit for App
  Store distribution (its setup is docs/billing-setup.md §11). Sign in with
  Apple does need one, and it also needs the matching capability enabled on the
  App ID in the Apple Developer portal — without that, signing fails outright.
  See docs/apple-sign-in.md.

  App Group `group.day.nuvo.app` is registered on App ID day.nuvo.app. The
  widget App ID (day.nuvo.app.widgets) has no capabilities, so this group is
  not declared on the extension.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.day.nuvo.app</string>
	</array>
</dict>
</plist>
