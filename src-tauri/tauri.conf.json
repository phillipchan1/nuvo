{
  "productName": "Nuvo",
  "version": "0.1.0",
  "identifier": "com.nuvo.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5717",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "TAURI_BUILD=1 npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Nuvo",
        "width": 1280,
        "height": 800,
        "minWidth": 380,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      },
      {
        "label": "spotlight",
        "width": 680,
        "height": 480,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "center": true,
        "focus": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    },
    "iOS": {
      "minimumSystemVersion": "15.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU3NTIzQkQwODJBNEY3MkIKUldRcjk2U0MwRHRTNXl2M0NHSnlBcUR4dG5BaWFoK0R5QTVHcHBJcmpPK3ZZUGhIMm44ZXZ3VUYK",
      "endpoints": [
        "https://github.com/phillipchan1/nuvo-releases/releases/latest/download/latest.json"
      ]
    }
  }
}
