{
  "productName": "Nuvo",
  "version": "0.1.0",
  "identifier": "com.nuvo.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "TAURI_BUILD=1 npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Nuvo",
        "width": 1280,
        "height": 800,
        "minWidth": 380,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 19, "y": 20 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/phillipchan1/nuvo-releases/releases/latest/download/latest.json"
      ]
    }
  }
}
